# ------------------------------------------------------------------------------
# Twenty CRM PRODUCTION — backup domain (20.ms.vasilisa.at)
# Same upstream as 20.mobilesentrix.com. Exists so the CRM stays reachable when
# the mobilesentrix.com zone / Cloudflare edge is having problems, so this host
# is deliberately DNS-only in Cloudflare and uses an automatic Let's Encrypt
# cert instead of a Cloudflare Origin CA cert.
# ------------------------------------------------------------------------------

20.ms.vasilisa.at {
	import compression

	@chatwoot_assets path /dashboard/images/* /dashboard/audio/*
	rewrite @chatwoot_assets /chatwoot-embed{uri}

	handle /assets/images/* {
		reverse_proxy {
			import chatwoot_blue_green
		}
	}

	handle /fasttext/* {
		reverse_proxy {
			import chatwoot_blue_green
		}
	}

	handle_path /chatwoot-embed/* {
		reverse_proxy {
			import chatwoot_blue_green
		}
	}

	handle_path /chatwoot-api/* {
		reverse_proxy {
			import chatwoot_blue_green
		}
	}

	handle /member-chatwoot/* {
		reverse_proxy ms-twenty-prod-server:3000
	}

	handle /member-whatsapp/* {
		reverse_proxy ms-twenty-prod-server:3000
	}

	handle /graphql {
		reverse_proxy ms-twenty-prod-server:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy ms-twenty-prod-server:3000
	}
}

# ==============================================================================
# WAHA (WhatsApp)
# ==============================================================================

waha.dev.mobilesentrix.com {
	import tls_dev
	import compression
	reverse_proxy ms-waha:3000
}

waha-dev.vasilisa.at {
	import compression
	reverse_proxy ms-waha:3000
}

waha-ms.vasilisa.at {
	import compression
	reverse_proxy ms-waha-ms:3000
}

# Internal entry to Chatwoot for services on ms-network (WAHA, Twenty prod):
# http://ms-proxy:8088 goes through the same blue/green pair with 30 s of retries,
# so a Chatwoot deploy no longer drops their requests (they used to call
# ms-chatwoot-prod-blue:3000 directly and lost WhatsApp messages while it restarted).
# Not published on the host: only containers on ms-network can reach it.
http://:8088 {
	reverse_proxy {
		import chatwoot_blue_green
	}
}
