# ==============================================================================
# TWENTY CRM DEV (port 3000, chatwoot-embed via dev port 4000)
# ==============================================================================

20.dev.mobilesentrix.com {
	import tls_dev
	import compression

	# Chatwoot static assets — rewrite to /chatwoot-embed/ prefix so the
	# existing handle_path rule forwards them to Chatwoot Rails.
	@chatwoot_assets path /dashboard/images/* /dashboard/audio/*
	rewrite @chatwoot_assets /chatwoot-embed{uri}

	# Rails public/ assets (profile hotkeys, captain, bot avatar)
	handle /assets/images/* {
		reverse_proxy 172.18.0.1:4000
	}

	# Chatwoot embeddable bundle — static JS/CSS served by Rails
	handle_path /chatwoot-embed/* {
		reverse_proxy 172.18.0.1:4000
	}

	# Chatwoot API + ActionCable WebSocket — proxied to Rails
	handle_path /chatwoot-api/* {
		reverse_proxy 172.18.0.1:4000
	}

	# Member integration endpoints
	handle /member-chatwoot/* {
		reverse_proxy 172.18.0.1:3000
	}

	handle /member-whatsapp/* {
		reverse_proxy 172.18.0.1:3000
	}

	# GraphQL with SSE support
	handle /graphql {
		reverse_proxy 172.18.0.1:3000 {
			flush_interval -1
		}
	}

	# Everything else — Twenty server (serves both API and frontend in production)
	handle {
		reverse_proxy 172.18.0.1:3000
	}
}

